# ─── API ───────────────────────────────────────────────────────────────────
# Leave VITE_API_URL empty to use the Vite dev proxy (same origin) — that is
# the simplest setup and avoids CORS entirely during development.
# Set it to your public API URL when the frontend is deployed separately.
VITE_API_URL=

# Socket.IO origin. Leave empty to reuse the page origin (works with the proxy).
VITE_SOCKET_URL=

# ─── Google Maps ───────────────────────────────────────────────────────────
# Required for maps, the location picker and address search.
# Enable BOTH "Maps JavaScript API" and "Places API" on the key, and restrict
# it by HTTP referrer (e.g. http://localhost:5173/*) before committing to prod.
VITE_GOOGLE_MAPS_API_KEY=

# Accepted as an alias so a key copied from a Create React App project works.
REACT_APP_GOOGLE_MAPS_API_KEY=

# ─── Dev only ──────────────────────────────────────────────────────────────
# Where `npm run dev` proxies /api, /uploads and /socket.io.
VITE_DEV_API_TARGET=http://localhost:5000
