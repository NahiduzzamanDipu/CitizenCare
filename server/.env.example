# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Allowed browser origin(s) for CORS and Socket.IO. Comma-separate for several.
CLIENT_URL=http://localhost:5173

# Hops to trust for the client IP (rate limiting). 1 behind one proxy, 0 direct.
TRUST_PROXY_HOPS=1

# ─── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/citizen_care
MONGO_TIMEOUT_MS=10000

# ─── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED. Use a long random string; 32+ characters is enforced in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=300
RATE_LIMIT_FRAMES=240
# Set true only for load testing.
DISABLE_RATE_LIMIT=false

# ─── Media storage ─────────────────────────────────────────────────────────
# Leave the Cloudinary values empty to store uploads on local disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=./uploads

# ─── AI detection ──────────────────────────────────────────────────────────
# The bundled Flask + YOLOv8 service in /ai-model.
PYTHON_AI_URL=http://127.0.0.1:5050
PYTHON_AI_TIMEOUT_MS=30000

# Optional external inference endpoint used only if PYTHON_AI_URL is unset.
YOLOV8_API_URL=
YOLOV8_API_KEY=

# ─── CCTV tuning ───────────────────────────────────────────────────────────
# Confidence floor and inference size sent to the Python service per frame.
CCTV_CONF_THRESHOLD=0.10
CCTV_IMGSZ=640
# Persist one snapshot per camera at most this often (ms).
CCTV_STATUS_SNAPSHOT_MS=800
# Push a live preview frame to the staff dashboard at most this often (ms).
CCTV_LIVE_PUSH_MS=450
# In-memory live-camera tracking limits.
CCTV_MAX_CAMERAS=64
CCTV_CAMERA_TTL_MS=300000

# ─── Seed data (npm run seed) ──────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@citizencare.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_POLICE_EMAIL=police@citizencare.local
SEED_POLICE_PASSWORD=Police12345!
SEED_CITIZEN_EMAIL=citizen@citizencare.local
SEED_CITIZEN_PASSWORD=Citizen12345!
SEED_STATION_NAME=Central Police Station
SEED_STATION_CODE=PS-CENTRAL01
SEED_STATION_DISTRICT=Dhaka
